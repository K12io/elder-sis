<%- include('../partials/header', { pageTitle: 'Administration', activeTab: 'admin' }) %>

<div class="sis-page-title">Administration</div>

<div class="sis-metabar">
  <span class="meta-label">Current term:</span>
  <span class="meta-strong"><%= termName || '(none set)' %></span>
  &nbsp;|&nbsp; <span class="meta-label">District:</span> Valley View Unified
  &nbsp;|&nbsp; <span class="meta-label">Build:</span> demo
</div>

<table class="layout">
<tr>
<td class="col-left" style="width:220px;vertical-align:top;">

  <div class="sis-box">
    <div class="sis-box-title">Administration</div>
    <div class="sis-box-body">
      <div class="sis-rail">
        <a href="/admin" class="current">Overview<span class="fineprint"> &mdash; all areas</span></a>
        <a href="/admin/school-year">School Year<span class="fineprint"> &mdash; <%= counts.terms %> terms</span></a>
        <a href="/admin/codes">Codes<span class="fineprint"> &mdash; <%= counts.codes %> codes</span></a>
        <a href="/admin/users">Users<span class="fineprint"> &mdash; <%= counts.users %> users</span></a>
        <a href="/admin/roles">Roles<span class="fineprint"> &mdash; <%= counts.roles %> roles</span></a>
      </div>
    </div>
  </div>

</td>
<td class="col-right" style="vertical-align:top;">

  <div class="sis-box">
    <div class="sis-box-title">School Year</div>
    <div class="sis-box-body">
      <p>Term calendar setup and current-term selection.</p>
      <p><a href="/admin/school-year">Open School Year &amp; Terms</a>
         &nbsp;<span class="fineprint"><%= counts.terms %> terms</span></p>
    </div>
  </div>

  <div class="sis-box">
    <div class="sis-box-title">Codes</div>
    <div class="sis-box-body">
      <p>Grade scale codes with editable percentage ranges.</p>
      <p><a href="/admin/codes">Open Grade Codes</a>
         &nbsp;<span class="fineprint"><%= counts.codes %> codes</span></p>
    </div>
  </div>

  <div class="sis-box">
    <div class="sis-box-title">Users</div>
    <div class="sis-box-body">
      <p>Staff accounts and role assignments (no passwords in this demo).</p>
      <p><a href="/admin/users">Open Users</a>
         &nbsp;<span class="fineprint"><%= counts.users %> users</span></p>
    </div>
  </div>

  <div class="sis-box">
    <div class="sis-box-title">Roles</div>
    <div class="sis-box-body">
      <p>Role descriptions and module-visibility notes.</p>
      <p><a href="/admin/roles">Open Roles</a>
         &nbsp;<span class="fineprint"><%= counts.roles %> roles</span></p>
    </div>
  </div>

</td>
</tr>
</table>

<%- include('../partials/footer') %>
