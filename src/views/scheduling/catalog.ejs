<%- include('../partials/header', { pageTitle: 'Course Catalog', activeTab: 'schedule' }) %>

<div class="sis-page-title">Course Catalog</div>

<% if (typeof msg !== 'undefined' && msg) { %>
  <div class="sis-metabar"><span class="meta-label">Status:</span> <span class="meta-strong"><%= msg %></span></div>
<% } %>
<% if (typeof err !== 'undefined' && err) { %>
  <div class="sis-box"><div class="sis-box-body"><strong>Error:</strong> <%= err %></div></div>
<% } %>

<table class="layout">
<tr>
<td class="col-left" style="vertical-align: top;">

  <div class="sis-box">
    <div class="sis-box-title">Courses (<%= courses.length %>)</div>
    <div class="sis-box-body">
      <table class="sis-table">
        <thead>
          <tr>
            <th>Course</th>
            <th>Department</th>
            <th class="num">Credits</th>
            <th>Grade levels</th>
            <th class="num">Sections</th>
            <th>Edit</th>
          </tr>
        </thead>
        <tbody>
          <% if (!courses.length) { %>
          <tr><td colspan="6">No courses in the catalog yet.</td></tr>
          <% } %>
          <% courses.forEach(function (c) { %>
          <tr>
            <td><%= c.course_name %></td>
            <td><%= c.department || '' %></td>
            <td class="num"><%= c.credits %></td>
            <td><%= c.grade_levels || '' %></td>
            <td class="num"><%= c.section_count %></td>
            <td><a href="/scheduling/catalog?edit=<%= c.id %>">Edit</a></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

</td>
<td class="col-right" style="vertical-align: top;">

  <div class="sis-box">
    <div class="sis-box-title"><%= editing ? 'Edit Course' : 'Add Course' %></div>
    <div class="sis-box-body">
      <form method="post" action="/scheduling/catalog">
        <% if (editing) { %>
        <input type="hidden" name="id" value="<%= editing.id %>">
        <% } %>
        <table class="kv">
          <tr>
            <th>Course name</th>
            <td><input type="text" name="course_name" size="24" maxlength="120" value="<%= editing ? editing.course_name : '' %>"></td>
          </tr>
          <tr>
            <th>Department</th>
            <td><input type="text" name="department" size="24" maxlength="80" value="<%= editing ? (editing.department || '') : '' %>"></td>
          </tr>
          <tr>
            <th>Credits</th>
            <td><input type="text" name="credits" size="6" maxlength="4" value="<%= editing ? editing.credits : '' %>"></td>
          </tr>
          <tr>
            <th>Grade levels</th>
            <td><input type="text" name="grade_levels" size="12" maxlength="40" placeholder="e.g. 9-12" value="<%= editing ? (editing.grade_levels || '') : '' %>"></td>
          </tr>
          <tr>
            <th>Description</th>
            <td><textarea name="description" rows="3" cols="30"><%= editing ? (editing.description || '') : '' %></textarea></td>
          </tr>
        </table>
        <p>
          <button type="submit" class="sis-button-go"><%= editing ? 'Save Changes' : 'Add Course' %></button>
          <% if (editing) { %>&nbsp;<a href="/scheduling/catalog">Cancel</a><% } %>
        </p>
      </form>
    </div>
  </div>

  <div class="sis-box">
    <div class="sis-box-title">Module Contents</div>
    <div class="sis-box-body">
      <ul class="links">
        <li><a href="/scheduling">Sections</a> &mdash; all sections, filterable</li>
        <li><a href="/scheduling/master">Master schedule</a> &mdash; periods &times; teachers grid</li>
        <li><a href="/scheduling/student?student=1">Student schedule</a> &mdash; by period</li>
      </ul>
    </div>
  </div>

</td>
</tr>
</table>

<%- include('../partials/footer') %>
