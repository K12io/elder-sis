<%- include('../partials/header', { pageTitle: 'Master Schedule', activeTab: 'schedule' }) %>

<div class="sis-page-title">Master Schedule</div>

<% if (typeof err !== 'undefined' && err) { %>
  <div class="sis-metabar" style="background:#fdf0ef; border-color:#c98a85;"><span class="meta-label">Error:</span> <span class="meta-strong"><%= err %></span></div>
<% } %>

<div class="sis-box">
  <div class="sis-box-title">Filters</div>
  <div class="sis-box-body">
    <form method="get" action="/scheduling/master">
      <span class="ctx-label">School:</span>
      <select name="school">
        <% schools.forEach(function (s) { %>
        <option value="<%= s.id %>"<% if (s.id === schoolId) { %> selected<% } %>><%= s.name %></option>
        <% }); %>
      </select>
      <button type="submit" class="btn">Show Grid</button>
    </form>
  </div>
</div>

<div class="sis-box">
  <div class="sis-box-title">Master Grid &mdash; Periods 1&ndash;7 by Teacher</div>
  <div class="sis-box-body">

    <% var clashKeys = []; for (var p of periods) for (var t of teachers) if (teacherClash.has(p + ':' + t.id)) clashKeys.push(p + ':' + t.id); %>
    <% var teacherIds = teachers.map(function (t) { return t.id; }); %>

    <!-- P8: results bar above the grid -->
    <div class="sis-resultsbar" style="margin-bottom:6px;">
      <span class="sis-results-count"><%= sections.length %> section<%= sections.length === 1 ? '' : 's' %> &middot; <%= teachers.length %> teacher<%= teachers.length === 1 ? '' : 's' %></span>
      <span class="sis-results-actions">
        <a class="sis-btn-secondary" href="/scheduling/catalog" title="Open the course catalog">Catalog</a>
      </span>
      <div class="clear"></div>
    </div>

    <!-- P6: teacher stepper bar with real prev/next links (school filter preserved) -->
    <div class="sis-stepper">
      <a class="sis-step-arrow" href="/scheduling/master?school=<%= schoolId %>&amp;teacher=<%= teacherIds.length ? teacherIds[teacherIds.length - 1] : '' %>"
         title="Previous teacher">&lsaquo;</a>
      <span class="sis-step-label">Teacher</span>
      <span class="sis-step-menu" title="teacher picker is not implemented in this demo">&#9662;</span>
      <a class="sis-step-arrow" href="/scheduling/master?school=<%= schoolId %>&amp;teacher=<%= teacherIds.length ? teacherIds[0] : '' %>"
         title="Next teacher">&rsaquo;</a>
      &nbsp;<span class="fineprint"><%= teachers.length %> teacher<%= teachers.length === 1 ? '' : 's' %> at this school; the grid is school-scoped and the teacher picker is display-only in this demo.</span>
      <div class="clear"></div>
    </div>

    <% if (clashKeys.length) { %>
    <div class="sis-metabar" style="background:#fdf0ef; border-color:#c98a85; margin-bottom:6px;">
      <span class="meta-strong"><%= clashKeys.length %></span> teacher double-booking(s) highlighted in red below.
    </div>
    <% } %>

    <table class="sis-table">
      <thead>
        <tr>
          <th>Period</th>
          <% teachers.forEach(function (t) { %>
          <th><%= t.name %></th>
          <% }); %>
        </tr>
      </thead>
      <tbody>
        <% for (var p of periods) { %>
        <tr>
          <td class="num"><%= p %></td>
          <% teachers.forEach(function (t) { %>
          <% var isClash = teacherClash.has(p + ':' + t.id); %>
          <% var here = sections.filter(function (s) { return s.teacher_id === t.id && s.period === p; }); %>
          <td>
            <% if (isClash) { %><span class="sis-status-bad" title="scheduling conflict">&#10005;</span>&nbsp;<% }
               else if (here.length) { %><span class="sis-status-ok" title="in schedule">&#10003;</span>&nbsp;<% } %>
            <% here.forEach(function (s) { %>
              <div<% if (isClash) { %> class="sis-metabar" style="background:#fff3c4;"<% } %>>
                <a href="/scheduling/section?section=<%= s.id %>"><%= s.course_name %></a>
                &middot; <%= s.room %> &middot; <%= s.section_code %>
              </div>
            <% }); %>
          </td>
          <% }); %>
        </tr>
        <% } %>
      </tbody>
    </table>

    <% if (!teachers.length) { %>
    <p class="fineprint">No teachers are assigned to this school.</p>
    <% } %>
  </div>
</div>

<div class="sis-box">
  <div class="sis-box-title">Room Clashes</div>
  <div class="sis-box-body">
    <% var roomKeys = []; for (var p of periods) sections.forEach(function (s) { if (s.room && roomClash.has(p + ':' + s.room)) roomKeys.push({ period: p, room: s.room, section: s }); }); %>
    <% if (roomKeys.length) { %>
    <table class="sis-table">
      <thead><tr><th class="num">Period</th><th>Room</th><th>Sections booked</th></tr></thead>
      <tbody>
        <% var seen = {}; %>
        <% roomKeys.forEach(function (k) { %>
        <% var key = k.period + '|' + k.room; if (seen[key]) return; seen[key] = true; %>
        <tr>
          <td class="num"><%= k.period %></td>
          <td><%= k.room %></td>
          <td>
            <% sections.filter(function (s) { return s.period === k.period && s.room === k.room; }).forEach(function (s, i) { %>
            <% if (i > 0) { %>, <% } %>
            <a href="/scheduling/section?section=<%= s.id %>"><%= s.course_name %></a>
            <% }); %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="fineprint">No room double-bookings at this school.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
