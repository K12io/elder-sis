<%- include('../partials/header', { pageTitle: 'Grading', activeTab: 'grades' }) %>

<div class="sis-page-title">Grading &mdash; Sections</div>

<div class="sis-box">
  <div class="sis-box-title">Section List</div>
  <div class="sis-box-body">

    <form method="get" action="/grading" style="margin-bottom:6px;">
      <label for="school"><strong>School:</strong></label>
      <select id="school" name="school">
        <option value="">All schools</option>
        <% schools.forEach(function (s) { %>
          <option value="<%= s.id %>"<%= String(schoolId) === String(s.id) ? ' selected' : '' %>><%= s.name %></option>
        <% }); %>
      </select>
      <button type="submit" class="sis-button">Filter</button>
      <% if (schoolId) { %>
        <a href="/grading">Clear</a>
      <% } %>
    </form>

    <div class="sis-resultsbar">
      <span class="sis-results-count"><%= sections.length %> section<%= sections.length === 1 ? '' : 's' %></span>
      <span class="sis-results-actions">
        <a class="sis-btn-secondary" href="/grading<%= schoolId ? '?school=' + schoolId : '' %>">Refresh</a>
      </span>
    </div>

    <table class="sis-table">
      <thead>
        <tr>
          <th>Course</th>
          <th>Section</th>
          <th>Teacher</th>
          <th>Period</th>
          <th>Room</th>
          <th>School</th>
          <th class="num">Assignments</th>
          <th>Setup</th>
          <th>Scores</th>
        </tr>
      </thead>
      <tbody>
        <% if (!sections.length) { %>
          <tr><td colspan="9">No sections found.</td></tr>
        <% } %>
        <% sections.forEach(function (s) { %>
          <tr>
            <td><%= s.course_name %></td>
            <td><%= s.section_code %></td>
            <td><%= s.teacher_name %></td>
            <td class="num"><%= s.period %></td>
            <td><%= s.room %></td>
            <td><%= s.school_name %></td>
            <td class="num"><%= s.assignment_count %></td>
            <td><a href="/grading/setup?section=<%= s.id %>">Setup</a></td>
            <td><a href="/grading/scores?section=<%= s.id %>">Scores</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>

  </div>
</div>

<%- include('../partials/footer') %>
