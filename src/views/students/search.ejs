<%- include('../partials/header', { pageTitle: 'Student Search', activeTab: 'students' }) %>

<div class="sis-page-title">Student Search</div>

<table class="layout">
<tr>
<td class="col-left">

  <div class="sis-box">
    <div class="sis-box-title">Search Criteria</div>
    <div class="sis-box-body">
      <form action="/students/search" method="get">
        <table class="sis-table kv">
          <tr>
            <th>Last name / ID</th>
            <td><input type="text" name="q" value="<%= q %>" size="24"> <button type="submit" class="btn">Search</button></td>
          </tr>
        </table>
      </form>
      <p class="fineprint">Current query: <code><%= q.length ? q : '(none)' %></code></p>
    </div>
  </div>

</td>
<td class="col-right">

  <div class="sis-box">
    <div class="sis-box-title">Results</div>
    <div class="sis-box-body">
      <p>No records to display yet &mdash; student search arrives with the Student Records slice.</p>
      <p class="fineprint">Module scaffold &mdash; working screens land in a later slice (see LOOP.md).</p>
    </div>
  </div>

</td>
</tr>
</table>

<%- include('../partials/footer') %>
