<%- include('../partials/header', { pageTitle: 'Student Records', activeTab: 'students' }) %>

<div class="sis-page-title">Student Records &mdash; Roster Search</div>

<table class="layout">
<tr>
<td class="col-left">

  <div class="sis-box">
    <div class="sis-box-title">Search Criteria</div>
    <div class="sis-box-body">
      <form action="/students" method="get">
        <table class="sis-table kv">
          <tr>
            <th>Last name</th>
            <td><input type="text" name="last" value="<%= criteria.last %>" size="18"></td>
            <th>First name</th>
            <td><input type="text" name="first" value="<%= criteria.first %>" size="18"></td>
          </tr>
          <tr>
            <th>State ID</th>
            <td><input type="text" name="state_id" value="<%= criteria.stateId %>" size="14"></td>
            <th>Grade level</th>
            <td>
              <select name="grade">
                <option value="">(any)</option>
                <% grades.forEach(function (g) { %>
                <option value="<%= g.value %>"<% if (criteria.grade === g.value) { %> selected<% } %>><%= g.label %></option>
                <% }); %>
              </select>
            </td>
          </tr>
          <tr>
            <th>Status</th>
            <td>
              <select name="status">
                <option value="">(any)</option>
                <% statuses.forEach(function (st) { %>
                <option value="<%= st %>"<% if (criteria.status === st) { %> selected<% } %>><%= st %></option>
                <% }); %>
              </select>
            </td>
            <td colspan="2">&nbsp;</td>
          </tr>
        </table>

        <!-- P8: filter/checkbox row above the panel body -->
        <div class="sis-filters">
          <label><input type="checkbox" name="include_inactive"> Include inactive students</label>
          <label><input type="checkbox" name="all_schools"> Search all schools</label>
          <label><input type="checkbox" name="fuzzy"> Fuzzy search</label>
        </div>
        <p class="fineprint" style="margin:0 0 2px;">
          These three checkboxes are display-only placeholders in this demo and are not read by
          the server; grade and status are filtered with the dropdowns above.
        </p>

        <!-- P9: wide red primary button spanning the criteria panel -->
        <button type="submit" class="sis-button-primary-danger sis-full">Search</button>
        <p style="margin:4px 0 0;"><a href="/students">Clear criteria</a></p>
      </form>
    </div>
  </div>

  <!-- P3: small link rail under the panel (all inert in this demo) -->
  <div class="sis-linkrail">
    <a href="/students" title="not implemented in this demo">Recently viewed</a>
    &middot;
    <a href="/students" title="not implemented in this demo">Multi student search</a>
    &middot;
    <a href="/students" title="not implemented in this demo">Multi-year search</a>
  </div>

</td>
<td class="col-right">

  <div class="sis-box">
    <div class="sis-box-title">Search Notes</div>
    <div class="sis-box-body">
      <p>Name and State ID fields match on a partial value. Grade and status must match exactly.</p>
      <p class="fineprint">Roster results are capped at 50 rows; refine criteria to narrow a large match.</p>
    </div>
  </div>

</td>
</tr>
</table>

<div class="sis-box">
  <div class="sis-box-title">Roster Results</div>
  <div class="sis-box-body">
    <!-- P8/P10: results bar above the grid -->
    <div class="sis-resultsbar">
      <span class="sis-results-count"><%= rows.length %> record<%= rows.length === 1 ? '' : 's' %></span>
      <span class="sis-results-actions">
        <% var rosterQs = [];
           if (criteria.last) rosterQs.push('last=' + encodeURIComponent(criteria.last));
           if (criteria.first) rosterQs.push('first=' + encodeURIComponent(criteria.first));
           if (criteria.stateId) rosterQs.push('state_id=' + encodeURIComponent(criteria.stateId));
           if (criteria.grade) rosterQs.push('grade=' + encodeURIComponent(criteria.grade));
           if (criteria.status) rosterQs.push('status=' + encodeURIComponent(criteria.status)); %>
        <a class="sis-btn-secondary" href="/students<% if (rosterQs.length) { %>?<%= rosterQs.join('&') %>&print=1<% } else { %>?print=1<% } %>"
           title="Re-renders this page as-is for printing">Print roster</a>
      </span>
      <div class="clear"></div>
    </div>
    <p class="fineprint" style="margin:4px 0;">
      <% if (hasCriteria) { %>
      <strong><%= total %></strong> record<%= total === 1 ? '' : 's' %> found matching the search criteria.
      <% } else { %>
      Showing the first <strong><%= rows.length %></strong> of <strong><%= total %></strong> students (ordered by last, first). Enter criteria to narrow the list.
      <% } %>
    </p>
    <table class="sis-table">
      <thead>
        <tr>
          <th>State ID</th>
          <th>Last</th>
          <th>First</th>
          <th>Grade</th>
          <th>Gender</th>
          <th>Birth date</th>
          <th>School</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (rows.length === 0) { %>
        <tr>
          <td colspan="8"><em>No records to display</em></td>
        </tr>
        <% } else { %>
        <% rows.forEach(function (r) { %>
        <tr>
          <td><a href="/students/<%= r.id %>"><%= r.state_id %></a></td>
          <td><%= r.last_name %></td>
          <td><%= r.first_name %></td>
          <td class="num"><%= intToGrade(r.grade_level) %></td>
          <td><%= r.gender || '' %></td>
          <td class="num"><%= r.dob ? String(r.dob).slice(0, 10) : '' %></td>
          <td><%= r.school_name || '' %></td>
          <td><%= r.status %></td>
        </tr>
        <% }); %>
        <% } %>
      </tbody>
    </table>
    <% if (total > rows.length) { %>
    <p class="fineprint">Listing first <%= rows.length %> of <%= total %>. Refine criteria to see the rest.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
