<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=1024">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' :: ' : '' %>Elder</title>
<link rel="stylesheet" href="/css/app.css">
</head>
<body>

<%
  // Partial guard: works whether or not the view was rendered with these locals.
  var activeTab = typeof activeTab !== 'undefined' ? activeTab : '';
  var schoolName = typeof schoolName !== 'undefined' ? schoolName : 'Valley View High';
  var termName = typeof termName !== 'undefined' ? termName : 'Year 2026–2027 · Term 2';
  var userName = typeof userName !== 'undefined' ? userName : 'Demo User';

  // Nav tabs. `pub: true` tabs are visible to anyone; the rest need a signed-in user
  // whose role is listed (Administrator sees everything). /admin, /fees and /discipline
  // are additionally enforced server-side in src/app.js.
  var tabs = [
    { id: 'start',        label: 'Start Page',        href: '/',                pub: true },
    { id: 'students',     label: 'Student Records',   href: '/students',        pub: true },
    { id: 'schedule',     label: 'Scheduling',        href: '/scheduling',      pub: true },
    { id: 'attend',       label: 'Attendance',        href: '/attendance',      pub: true },
    { id: 'grades',       label: 'Grading',           href: '/grading',         pub: true },
    { id: 'transcripts',  label: 'Grades & Transcripts', href: '/grades',       pub: true },
    { id: 'reports',      label: 'Reports',           href: '/reports',         pub: true },
    { id: 'teacher',      label: 'Teacher Workspace', href: '/teacher',         pub: true },
    { id: 'portal',       label: 'Family Portal',     href: '/portal',          pub: true },
    { id: 'communications', label: 'Communications',  href: '/communications',  pub: true },
    { id: 'assessment',   label: 'Assessment',        href: '/assessment',      pub: true },
    { id: 'fees',         label: 'Fees',              href: '/fees',            pub: false, roles: ['Administrator', 'Registrar'] },
    { id: 'admin',        label: 'Administration',    href: '/admin',           pub: false, roles: ['Administrator'] },
  ];

  // Resolve who is looking and what they may see. When nobody is signed in only the
  // public tabs render and the control cluster offers a Login link instead of a chip.
  var cu = (typeof currentUser !== 'undefined' && currentUser) ? currentUser : null;
  var cuRoles = cu ? (cu.roles || []).map(function (r) { return String(r).toLowerCase(); }) : [];
  var isAdmin = cuRoles.indexOf('administrator') !== -1;
  var visibleTabs = tabs.filter(function (t) {
    if (!cu) return false; // default-deny: no menu until signed in
    if (t.pub) return true;
    if (isAdmin) return true;
    return (t.roles || []).some(function (r) { return cuRoles.indexOf(String(r).toLowerCase()) !== -1; });
  });
  if (cu && !userName) { userName = cu.display_name || cu.username || userName; }
%>

<div id="shell">

  <%
    // Initials for the circular user chip (D1 control cluster).
    var initials = String(userName).split(/\s+/).filter(Boolean)
      .map(function (w) { return w.charAt(0).toUpperCase(); }).slice(0, 2).join('') || '?';
  %>

  <!-- D1 tier 1: solid navy branding bar -->
  <div id="topbar">
    <div id="topbar-title">Valley View Unified School District &mdash; Elder SIS</div>
  </div>

  <% if (cu) { %>
  <!-- D1 tier 2: darker context/action strip + control cluster -->
  <!-- Anonymous visitors get only the branding bar — no menu, school, term or
       user context, and no quick-search or control-cluster shortcuts until sign-in. -->
  <div id="topbar-context">
    <div class="sis-control-cluster">
      <form class="quicksearch" action="/students/search" method="get">
        <label for="quicksearch">Search:</label>
        <input type="text" id="quicksearch" name="q" size="14" placeholder="Student name or ID">
        <button type="submit" class="sis-iconbtn" title="Search">&#8981;</button>
      </form>
      <a class="sis-iconbtn" href="/reports" title="Reports">R</a>
      <a class="sis-iconbtn" href="/admin" title="Administration">A</a>
      <a class="sis-iconbtn" href="/grades" title="Grades &amp; Transcripts">G</a>
      <% if (cu) { %>
        <span class="sis-userchip" title="<%= userName %> (<%= (cu.roles || []).join(', ') %>)"><%= initials %></span>
        <span class="ctx-label"><%= userName %></span>
        <form method="post" action="/auth/logout" style="margin:0;display:inline;">
          <button type="submit" class="sis-iconbtn" title="Sign out">&#8592;</button>
        </form>
      <% } else { %>
        <a class="sis-iconbtn" href="/auth/login" title="Sign in to the district SIS">Login</a>
      <% } %>
    </div>

    <span class="ctx-label">School:</span>
    <select class="sis-context-select" name="school">
      <option value="/admin" selected><%= schoolName %></option>
    </select>
    &nbsp;
    <span class="ctx-label">Year/Term:</span>
    <select class="sis-context-select">
      <option selected><%= termName %></option>
    </select>
    &nbsp;
    <span class="ctx-label">User:</span>
    <select class="sis-context-select">
      <option selected><%= userName %></option>
    </select>
    &nbsp;
    <a href="/admin" class="topbar-link">Switch School</a>
    <div class="clear"></div>
  </div>

  <div id="tabbar" role="navigation">
    <ul class="tabs">
      <% visibleTabs.forEach(function (t) { %>
      <li<% if (t.id === activeTab) { %> class="active"<% } %>><a href="<%= t.href %>"><%= t.label %></a></li>
      <% }); %>
    </ul>
    <div class="clear"></div>
  </div>
  <% } %>

  <div id="content">
